{
  "name": "dashboard",
  "version": "1.0.0",
  "description": "ChromVoid device",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build:password-import": "bun run --cwd ../../packages/password-import build",
    "generate:document-locale-bootstrap": "bun ./scripts/generate-document-locale-bootstrap.ts",
    "check:document-locale-bootstrap": "bun ./scripts/generate-document-locale-bootstrap.ts --check",
    "build": "bun run build:password-import && bun run --cwd ../../packages/passmanager build && bun run generate:document-locale-bootstrap && vite build",
    "build:check-warnings": "node ./scripts/check-build-warnings.mjs",
    "dev": "bun run build:password-import && bun run generate:document-locale-bootstrap && vite",
    "vendor:fonts": "bun ./scripts/vendor-fonts.ts",
    "lint": "bun run check:document-locale-bootstrap && tsc --project . --noEmit",
    "fix": "oxlint --fix \"**/*.{ts,tsx}\"",
    "test": "bun run build:password-import && vitest run --config ./vitest.unit.config.ts",
    "test:perf:gates": "vitest run --config ./vitest.unit.config.ts tests/unit/media-inspection-flow.test.ts tests/unit/image-display-scheduler.test.ts tests/unit/image-derivative-prewarm.test.ts tests/unit/catalog-sync.test.ts tests/unit/catalog.notifications.test.ts",
    "test:unit": "bun run build:password-import && vitest --config ./vitest.unit.config.ts",
    "test:unit:watch": "bun run build:password-import && vitest --config ./vitest.unit.config.ts --watch",
    "test:e2e": "DASHBOARD_E2E=1 vitest --config ./vitest.config.ts",
    "test:e2e:headed": "DASHBOARD_E2E=1 HEADED=1 vitest --config ./vitest.config.ts",
    "test:e2e:visual": "DASHBOARD_E2E=1 vitest --config ./vitest.config.ts tests/e2e/visual",
    "test:e2e:visual:update": "DASHBOARD_E2E=1 UPDATE_VISUAL_SNAPSHOTS=1 vitest --config ./vitest.config.ts tests/e2e/visual",
    "perf:passwords-root": "node ./scripts/perf-passmanager-root.mjs"
  },
  "keywords": [],
  "author": "Kaifat",
  "dependencies": {
    "@chromvoid/password-import": "workspace:*",
    "@chromvoid/scheme": "workspace:*",
    "@chromvoid/ui": "workspace:*",
    "@chromvoid/uikit": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lit-labs/virtualizer": "^2.1.1",
    "@project/i18n": "workspace:*",
    "@project/passmanager": "workspace:*",
    "@project/theme": "workspace:*",
    "@project/utils": "workspace:*",
    "@reatom/core": "^1001.0.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "dompurify": "^3.4.12",
    "gsap": "^3.15.0",
    "markdown-it": "^14.3.0",
    "lit": "^3.3.3",
    "prettier": "^3.9.5"
  },
  "devDependencies": {
    "@blazediff/core": "1.9.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@vitest/browser": "^4.1.10",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "pngjs": "7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wawoff2": "2.0.1"
  }
}
