{
  "include": ["./src/**/*"],
  "exclude": ["node_modules/*", "/scripts/*"],

  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["dom", "es2022", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "@project/i18n": ["../../packages/i18n/src/index.ts"],
      "@project/i18n/pure": ["../../packages/i18n/src/pure.ts"],
      "@project/i18n/*": ["../../packages/i18n/src/*"],
      "@project/passmanager/i18n": ["../../packages/passmanager/src/i18n/index.ts"],
      "@project/passmanager/i18n/format": ["../../packages/passmanager/src/i18n/format.ts"],
      "@project/passmanager/i18n/availability": [
        "../../packages/passmanager/src/i18n/availability.ts"
      ],
      "@chromvoid/password-import/i18n": ["../../packages/password-import/src/i18n.ts"],
      "@chromvoid/password-import/i18n/availability": [
        "../../packages/password-import/src/i18n/availability.ts"
      ],
      "@project/passmanager/core": ["../../packages/passmanager/src/core.ts"],
      "@project/passmanager/types": ["../../packages/passmanager/src/types.ts"],
      "@project/passmanager/ports": ["../../packages/passmanager/src/ports/index.ts"],
      "@project/passmanager/select": ["../../packages/passmanager/src/service/select.ts"],
      "@project/passmanager/sorting": ["../../packages/passmanager/src/service/sorting.ts"],
      "@project/passmanager/sort-storage": ["../../packages/passmanager/src/service/sort-storage.ts"],
      "@project/passmanager/security-audit": ["../../packages/passmanager/src/security-audit.ts"],
      "@project/passmanager/theme": ["../../packages/passmanager/src/service/theme.ts"],
      "@project/passmanager/timer": ["../../packages/passmanager/src/timer.ts"],
      "@project/passmanager/dialog": ["../../packages/passmanager/src/service/dialog.ts"],
      "@chromvoid/uikit": ["../../packages/uikit/dist/index.d.ts"],
      "@chromvoid/uikit/components": ["../../packages/uikit/dist/components/index.d.ts"],
      "@chromvoid/uikit/components/*": ["../../packages/uikit/dist/components/*.d.ts"],
      "@chromvoid/uikit/dialog": ["../../packages/uikit/dist/dialog/index.d.ts"],
      "@chromvoid/uikit/dialog/*": ["../../packages/uikit/dist/dialog/*.d.ts"],
      "@chromvoid/uikit/reatom-lit": ["../../packages/uikit/dist/reatom-lit/index.d.ts"],
      "@chromvoid/scheme": ["../../packages/scheme/src/index.ts"],
      "@chromvoid/scheme/*": ["../../packages/scheme/src/*"],
      "@chromvoid/ui": ["../../packages/ui/src/index.ts"],
      "@chromvoid/ui/*": ["../../packages/ui/src/*"],
      "root/*": ["./src/*"]
    },

    // Type checking
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,

    // Module options
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "allowUnreachableCode": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  }
}
