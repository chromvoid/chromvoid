{
  "name": "browser-extension",
  "version": "1.0.0",
  "description": "ChromVoid UNO configurator",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "bun run --cwd ../../packages/i18n build && tsx ./scripts/build.ts && node ./scripts/build-css.mjs && node ./scripts/package-extension.mjs && node ./scripts/check-bundle-size.mjs",
    "dev": "bun run --cwd ../../packages/i18n build && node ./scripts/build-css.mjs && tsx ./scripts/build.ts --watch",
    "build:css": "node ./scripts/build-css.mjs",
    "build:package": "node ./scripts/package-extension.mjs",
    "build:test-fixture": "tsx ./scripts/build-popup-fixture.ts",
    "fix": "oxlint --fix **/*.{ts,tsx}",
    "lint": "tsc --noEmit",
    "test": "bun run --cwd ../../packages/i18n build && node --import tsx --test --test-force-exit src/*.test.ts src/**/*.test.ts",
    "test:chrome": "bun run build && node --test --test-force-exit tests/chrome-extension.smoke.test.mjs",
    "test:ui": "bun run build && bun run build:test-fixture && node --test --test-force-exit tests/popup-ui.test.mjs",
    "check:bundle": "node ./scripts/check-bundle-size.mjs"
  },
  "keywords": [],
  "author": "Kaifat",
  "dependencies": {
    "@chromvoid/scheme": "workspace:*",
    "@project/i18n": "workspace:*",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@chromvoid/uikit": "workspace:*",
    "@reatom/core": "^1001.0.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.13.3",
    "@webcomponents/custom-elements": "^1.6.0",
    "browserslist": "^4.28.6",
    "lightningcss": "^1.32.0",
    "tsx": "^4.23.1",
    "vite": "^8.1.4"
  }
}
