# Copy this file to sideload-keystore.properties and update it for your local machine.
# This key signs the standalone APK distributed through GitHub Releases.
password=changeit
keyAlias=sideload
storeFile=/home/your-user/.chromvoid/android/chromvoid-sideload.jks
# SHA-256 certificate fingerprint from:
# keytool -list -v -keystore /home/your-user/.chromvoid/android/chromvoid-sideload.jks -alias sideload
certificateSha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
