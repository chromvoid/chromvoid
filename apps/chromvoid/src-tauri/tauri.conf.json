{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChromVoid",
  "version": "1.0.8",
  "identifier": "com.chromvoid.app",
  "build": {
    "beforeDevCommand": "node ./scripts/build-webview-if-needed.mjs --force",
    "beforeBuildCommand": "node ./scripts/build-webview-if-needed.mjs",
    "devUrl": null,
    "frontendDist": "../../webview/dist",
    "features": ["desktop"]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".dev"
    },
    "iOS": {
      "bundleVersion": "10",
      "developmentTeam": "LHWC37D5KT"
    },
    "macOS": {
      "infoPlist": "Info-macOS.plist",
      "entitlements": "gen/apple/build/credential-provider/stage/host-entitlements.plist",
      "files": {
        "MacOS/chromvoid-agent": "binaries/chromvoid-agent",
        "PlugIns/ChromVoidCredentialProvider.appex": "gen/apple/build/credential-provider/stage/ChromVoidCredentialProvider.appex",
        "embedded.provisionprofile": "gen/apple/build/credential-provider/stage/embedded.provisionprofile"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChromVoid",
        "width": 1200,
        "height": 820,
        "resizable": true,
        "disableInputAccessoryView": true
      }
    ],
    "security": {
      "capabilities": ["main-window", "mobile"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/chromvoid-preview/**"]
      },
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: chromvoid-preview: http://asset.localhost; media-src 'self' blob: asset: chromvoid-preview: chromvoid-media: http://asset.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; script-src 'self'; connect-src 'self' data: ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:8003; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none';"
    }
  }
}
