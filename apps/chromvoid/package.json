{
  "name": "@chromvoid/desktop",
  "private": true,
  "version": "2.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "icons:generate": "node ./scripts/generate-platform-icons.mjs",
    "dev:run": "node ./scripts/run-tauri-dev.mjs",
    "dev": "bun run dev:run",
    "setup:dev-signing": "bash ./scripts/setup-dev-codesign.sh",
    "build": "node ./scripts/run-tauri-build.mjs",
    "build:dmg": "node ./scripts/run-tauri-build.mjs --distribution --bundles dmg",
    "ios": "node ./scripts/run-tauri-ios-dev.mjs",
    "ios:sim": "node ./scripts/run-tauri-ios-dev.mjs \"iPhone 16\"",
    "ios:sim:17": "node ./scripts/run-tauri-ios-dev.mjs \"iPhone 17\"",
    "ios:sim:latest": "node ./scripts/run-tauri-ios-dev.mjs",
    "ios:sim:signed": "sh -c 'APPLE_DEVELOPMENT_TEAM=${APPLE_DEVELOPMENT_TEAM:?Set APPLE_DEVELOPMENT_TEAM} node ./scripts/run-tauri-ios-dev.mjs \"iPhone 16\"'",
    "ios:build": "node ./scripts/run-tauri-ios-build.mjs",
    "ios:init": "HOMEBREW_NO_ENV_HINTS=1 tauri ios init",
    "ios:build:release:ipa": "node ./scripts/run-tauri-ios-release-build.mjs",
    "ios:install:release:ipa": "node ./scripts/install-ios-release-ipa.mjs",
    "ios:dev:device": "node ./scripts/run-tauri-ios-dev.mjs --physical-device",
    "ios:release:device": "node ./scripts/run-tauri-ios-dev.mjs --physical-device --release",
    "ios:deploy:device": "bun run ios:build -- --build-number 1 && node ./scripts/install-ios-release-ipa.mjs",
    "ios:deploy:device:launch": "bun run ios:build -- --build-number 1 && node ./scripts/install-ios-release-ipa.mjs --launch",
    "ios:deploy:release:ipa": "bun run ios:build:release:ipa && node ./scripts/install-ios-release-ipa.mjs --launch",
    "android:usb-smoke": "cargo run --manifest-path src-tauri/Cargo.toml --features mobile-usb-smoke --bin mobile-usb-smoke --",
    "test:e2e": "bunx vitest run --config ./vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3"
  }
}
