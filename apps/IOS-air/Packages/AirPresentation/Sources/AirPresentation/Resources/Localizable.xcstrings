    "New address": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый адрес"
          }
        }
      }
    },
    "Bitcoin gives you a fresh address for every transfer for privacy. All previous addresses stay yours.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для приватности Bitcoin выдаёт свежий адрес на каждый перевод. Все прошлые адреса остаются вашими."
          }
        }
      }
    },
    "This address stays the same for every transfer.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот адрес не меняется от перевода к переводу."
