{
  "sourceLanguage": "en",
  "strings": {
    "Access to this item is denied.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to this item is denied."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к этому элементу."
          }
        }
      }
    },
    "Confirm it’s you to enter ChromVoid Air.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите, что это вы, чтобы войти в ChromVoid Air."
          }
        }
      }
    },
    "Enter a password.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пароль."
          }
        }
      }
    },
    "Repeat the administrative password.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите административный пароль."
          }
        }
      }
    },
    "The administrative passwords don’t match.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Административные пароли не совпадают."
          }
        }
      }
    },
    "The device key for this storage is unavailable. Your stored data has been preserved.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ устройства для этого хранилища недоступен. Сохранённые данные не изменены."
          }
        }
      }
    },
    "The operation could not finish. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить операцию. Попробуйте ещё раз."
          }
        }
      }
    },
    "Device authentication did not finish. Try again when you’re ready.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка владельца устройства не завершена. Повторите, когда будете готовы."
          }
        }
      }
    },
    "Preparing secure storage…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка хранилища…"
          }
        }
      }
    },
    "Everything yours.\nClose at hand.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё своё.\nПод рукой."
          }
        }
      }
    },
    "A quiet place for your private life. Your vault opens with your password and closes when you leave the app.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личное пространство без лишнего. Хранилище открывается вашим паролем и закрывается при выходе из приложения."
          }
        }
      }
    },
    "Encrypted on your device": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифровано на вашем устройстве"
          }
        }
      }
    },
    "A separate password for administrative actions": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельный пароль для административных действий"
          }
        }
      }
    },
    "Device authentication is optional": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка владельца устройства — по желанию"
          }
        }
      }
    },
    "Set up this device": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настроить устройство"
          }
        }
      }
    },
    "Development edition · separate from your existing ChromVoid app": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия для разработки · отдельно от вашего основного приложения ChromVoid"
          }
        }
      }
    },
    "Set your administrative password": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте административный пароль"
          }
        }
      }
    },
    "Keep this password safe. It protects administrative actions. You’ll use a separate vault password to open your private space.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните этот пароль в надёжном месте. Он защищает административные действия. Для входа в личное пространство вы будете использовать отдельный пароль хранилища."
          }
        }
      }
    },
    "Enter a vault password to open its space on this device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пароль хранилища, чтобы открыть его пространство на этом устройстве."
          }
        }
      }
    },
    "Administrative password": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль администратора"
