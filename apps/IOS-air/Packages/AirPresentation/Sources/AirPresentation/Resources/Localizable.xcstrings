            "state": "translated",
            "value": "Поделиться"
          }
        }
      }
    },
    "Send only assets of this network to this address. Anything sent from another network is lost.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте на этот адрес только активы этой сети. Переводы из других сетей будут потеряны."
          }
        }
      }
