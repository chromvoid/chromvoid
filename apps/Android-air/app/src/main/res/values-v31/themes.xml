<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The first branded frame belongs to the access screen, not the system splash. -->
    <style name="Theme.ChromVoidAir" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/air_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/air_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
