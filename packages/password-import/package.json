{
  "name": "@chromvoid/password-import",
  "version": "0.0.1",
  "description": "Credential import UI backed by shared ChromVoid Rust Core",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "default": "./dist/i18n.js"
    },
    "./i18n/availability": {
      "types": "./dist/i18n/availability.d.ts",
      "import": "./dist/i18n/availability.js",
      "default": "./dist/i18n/availability.js"
    },
    "./ui/import-dialog": {
      "types": "./dist/ui/import-dialog.d.ts",
      "import": "./dist/ui/import-dialog.js",
      "default": "./dist/ui/import-dialog.js"
    },
    "./ui/import-dialog-state": {
      "types": "./dist/ui/import-dialog-state.d.ts",
      "import": "./dist/ui/import-dialog-state.js",
      "default": "./dist/ui/import-dialog-state.js"
    },
    "./ui/mobile-file-picker-lifecycle": {
      "types": "./dist/ui/mobile-file-picker-lifecycle.d.ts",
      "import": "./dist/ui/mobile-file-picker-lifecycle.js",
      "default": "./dist/ui/mobile-file-picker-lifecycle.js"
    },
    "./ui/file-accept": {
      "types": "./dist/ui/file-accept.d.ts",
      "import": "./dist/ui/file-accept.js",
      "default": "./dist/ui/file-accept.js"
    },
    "./package.json": "./package.json",
    "./service": {
      "types": "./dist/credential-import-service.d.ts",
      "import": "./dist/credential-import-service.js",
      "default": "./dist/credential-import-service.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/postbuild.mjs",
    "check:bundle": "bun run build && node ./scripts/check-bundle-contract.mjs",
    "check:exports": "bun run build && node ./scripts/check-package-exports.mjs",
    "check:import-contract": "node ./scripts/check-import-contract.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run --config ./vitest.config.ts && bun run check:exports && bun run check:bundle && bun run check:import-contract",
    "test:unit": "vitest --config ./vitest.config.ts --watch"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "vitest": "^4.1.10",
    "fflate": "^0.8.3",
    "kdbxweb": "^2.1.1"
  },
  "peerDependencies": {
    "@chromvoid/uikit": "^2.0.0",
    "@reatom/core": "^1001.0.0",
    "lit": "^3.0.0",
    "@chromvoid/scheme": "^0.1.0"
  }
}
