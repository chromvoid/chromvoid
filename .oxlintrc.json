{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "unicorn", "typescript", "oxc", "import"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn"
  },
  "env": {
    "browser": true,
    "es2021": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "**/node_modules/**",
    "dist/**",
    "**/dist/**",
    "build/**",
    "**/build/**",
    ".mock/**",
    "**/.mock/**",
    "*.min.js",
    "**/*.min.js",
    "*.bundle.js",
    "**/*.bundle.js",
    ".cache/**",
    "coverage/**",
    "**/coverage/**",
    "**/*.d.ts",
    ".vscode/**",
    ".idea/**",
    "*.log",
    "backup/**",
    "**/backup/**",
    "**/*.md",
    "**/fixtures/**",
    "**/mocks/**",
    "**/test-data/**"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-inferrable-types": "error",
    "no-empty-function": "warn",
    "typescript/no-empty-interface": "warn",
    "typescript/no-namespace": "error",
    "typescript/no-var-requires": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "typescript/no-non-null-assertion": "off",
    "typescript/no-unnecessary-type-constraint": "off",
    "no-undef": "off",
    "no-redeclare": "off",
    "no-console": "warn",
    "no-empty": ["error", {"allowEmptyCatch": true}],
    "import/no-duplicates": "error",
    "no-restricted-properties": [
      "error",
      {
        "object": "window",
        "property": "store",
        "message": "Использовать getAppContext().store вместо window.store"
      },
      {
        "object": "window",
        "property": "ws",
        "message": "Использовать getAppContext().ws вместо window.ws"
      },
      {
        "object": "window",
        "property": "catalog",
        "message": "Использовать getAppContext().catalog вместо window.catalog"
      },
      {
        "object": "window",
        "property": "state",
        "message": "Использовать getAppContext().state вместо window.state"
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/webview/tests/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-properties": "off"
      }
    },
    {
      "files": ["backend/landings/**/*.tsx"],
      "rules": {
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^(?:_|jsx$|Fragment$)",
            "caughtErrorsIgnorePattern": "^_"
          }
        ]
      }
    }
  ]
}
